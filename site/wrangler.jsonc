// pane.threetwoa.live — the static site in public/, plus worker.js for
// language negotiation. Deploy with `npx wrangler deploy` from here
// (CI: .github/workflows/site-deploy.yml).
{
  "name": "pane",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // every request, so worker.js can negotiate the home page's language
    "run_worker_first": true
  },
  "routes": [{ "pattern": "pane.threetwoa.live", "custom_domain": true }],
  "observability": { "enabled": true }
}
