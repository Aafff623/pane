// pane.threetwoa.live — the Next.js static export in out/, served through
// worker.js. Build with `pnpm build`, then deploy with `npx wrangler deploy`
// from here (CI: .github/workflows/site-deploy.yml).
{
  "name": "pane",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // every request, so the worker stays the single entry point for the
    // site (business routes + the /api/latest proxy)
    "run_worker_first": true
  },
  "routes": [{ "pattern": "pane.threetwoa.live", "custom_domain": true }],
  "observability": { "enabled": true }
}
