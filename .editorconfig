# Editor basics the repo can rely on without adding a formatter dep:
# devDependencies are only tauri cli / typescript / vite, so .editorconfig
# is the single formatting authority for now.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_style = space
indent_size = 4

# Markdown line breaks can be two trailing spaces; keep them as written.
[*.md]
trim_trailing_whitespace = false
