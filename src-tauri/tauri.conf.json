{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pane",
  "version": "0.5.0",
  "identifier": "com.jazii.pane",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pane",
        "dragDropEnabled": false,
        "width": 450,
        "height": 640,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Aafff623/pane/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NUM0MENBQ0NCODJBQzAKUldUQUtyak15a0JjRlhRMHN1QWhXOGtPQ0pqYmtma3c3SjBPNTJheG1QaDlIblE0eG1oYTN1Y0wK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Pane",
    "copyright": "© 2026 Pane contributors (MIT)",
    "shortDescription": "Local-first AI usage dashboard",
    "longDescription": "Pane brings AI quotas, balances, reset times, account pools and local CLI token spend into one on-demand desktop panel. Built with Tauri, Rust and TypeScript, it keeps credentials on your computer. Windows is the primary development and validation platform; macOS and Linux builds are preview.",
    "homepage": "https://pane.threetwoa.live",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
